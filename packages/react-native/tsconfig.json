{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    // React Native has no DOM. Leaving it out means a stray `document` or
    // `localStorage` fails here rather than on a phone.
    "lib": ["es2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
